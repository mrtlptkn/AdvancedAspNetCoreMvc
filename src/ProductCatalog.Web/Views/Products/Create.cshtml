@model ProductFormViewModel
@{
    ViewData["Title"] = Localizer["NewProductTitle"].Value;
}

<h1 class="mb-6 text-2xl font-bold tracking-tight">@Localizer["NewProductTitle"]</h1>

<form asp-action="Create" method="post" class="max-w-lg space-y-4">
    <div>
        <label class="mb-1 block text-sm font-medium text-gray-700" asp-for="Name">@Localizer["NameLabel"]</label>
        <input class="input" asp-for="Name" />
        <span class="text-sm text-red-700" asp-validation-for="Name"></span>
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-700" asp-for="Category">@Localizer["CategoryLabel"]</label>
        <input class="input" asp-for="Category" />
        <span class="text-sm text-red-700" asp-validation-for="Category"></span>
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-700" asp-for="Description">@Localizer["DescriptionLabel"]</label>
        <textarea class="input min-h-24" asp-for="Description"></textarea>
        <span class="text-sm text-red-700" asp-validation-for="Description"></span>
    </div>

    <div>
        <label class="mb-1 block text-sm font-medium text-gray-700" asp-for="Price">@Localizer["PriceLabel"]</label>
        <input class="input" asp-for="Price" />
        <span class="text-sm text-red-700" asp-validation-for="Price"></span>
    </div>

    <button class="btn-primary" type="submit">@Localizer["SaveButton"]</button>
</form>
