@model CartViewModel
@{
    ViewData["Title"] = Localizer["CartTitle"].Value;
}

<h1 class="mb-6 text-2xl font-bold tracking-tight">@Localizer["CartTitle"]</h1>

@if (Model.Lines.Count == 0)
{
    <p class="text-gray-600">@Localizer["CartEmpty"]</p>
}
else
{
    <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm">
        <table class="w-full border-collapse text-left text-sm">
            <thead class="bg-gray-100 text-gray-700">
                <tr>
                    <th class="px-4 py-3 font-semibold">@Localizer["NameLabel"]</th>
                    <th class="px-4 py-3 font-semibold">@Localizer["PriceLabel"]</th>
                    <th class="px-4 py-3 font-semibold">@Localizer["Quantity"]</th>
                    <th class="px-4 py-3 font-semibold">@Localizer["LineTotal"]</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td class="px-4 py-3">
                            <a class="link" asp-controller="Products" asp-action="Details" asp-route-slug="@line.Product.Slug">@line.Product.Name</a>
                        </td>
                        <td class="px-4 py-3">@line.Product.Price.ToString("C")</td>
                        <td class="px-4 py-3">@line.Quantity</td>
                        <td class="px-4 py-3">@line.LineTotal.ToString("C")</td>
                        <td class="px-4 py-3 text-right">
                            <button type="button" class="remove-from-cart btn-secondary border-red-300 text-red-700 hover:bg-red-50" data-product-id="@line.Product.Id">@Localizer["Remove"]</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="mt-4 text-lg font-semibold">@Localizer["Total"]: <span id="cart-total">@Model.Total.ToString("C")</span></p>
}

<div class="mt-6">
    <a class="link" asp-controller="Products" asp-action="Index">@Localizer["ContinueShopping"]</a>
</div>
